{
  "name": "p-x402",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:facilitator": "bun --watch apps/facilitator/src/index.ts",
    "dev:server": "bun --watch apps/demo-server/src/index.ts",
    "demo": "bun apps/demo-client/src/index.ts",
    "demo:local": "bun apps/demo-client/src/all-in-one.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.lib.json",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/bun": "1.4.5",
    "typescript": "5.9.3"
  }
}
