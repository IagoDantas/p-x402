# p-x402 — copy to .env and fill in. Never commit .env.

# Facilitator (apps/facilitator)
PORT=4020
# mock (in-memory, default) or abacatepay
PX402_PROVIDER=mock
# Only with PX402_PROVIDER=abacatepay
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
# SQLite file for charges; omit to keep charges in memory
PX402_DB_PATH=./p-x402.sqlite
# One static merchant: id, bearer token and payTo id
PX402_MERCHANT_ID=loja1
PX402_MERCHANT_TOKEN=change-me-long-random-token
PX402_PAY_TO=loja1
# 1 enables POST /dev/charges/:id/simulate-payment (development only)
PX402_DEV_SIMULATE=1

# Demo seller API (apps/demo-server)
DEMO_SERVER_PORT=4021
PX402_FACILITATOR_URL=http://localhost:4020
# Set when the API runs behind a proxy, so the charged resource URL is the public one
PX402_PUBLIC_ORIGIN=

# Demo buyer (apps/demo-client)
DEMO_SERVER_URL=http://localhost:4021/relatorio
